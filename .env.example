# RideLink local configuration.
# Copy this file to ".env" in the same folder (the start scripts do it for you).
# ".env" is git-ignored: never commit real passwords or connection strings.

# ---- Shared JWT secret: identical for all four services, at least 32 characters ----
JWT_SECRET=ridelink-local-dev-secret-change-me-2026
JWT_TTL_MINUTES=120

# ---- Built-in administrator (Account Service) ----
ADMIN_USERNAME=admin@ridelink.lk
ADMIN_PASSWORD=Admin@12345

# ---- MongoDB: one database per service (each service owns its own data) ----
# Local MongoDB (or "docker compose up -d") works with the defaults below.
# To use MongoDB Atlas instead, replace each *_MONGODB_URI with your Atlas
# connection string and keep the database names.
ACCOUNT_MONGODB_URI=mongodb://localhost:27017
ACCOUNT_MONGODB_DATABASE=ridelink_accounts
DRIVER_MONGODB_URI=mongodb://localhost:27017
DRIVER_MONGODB_DATABASE=ridelink_drivers
RIDE_MONGODB_URI=mongodb://localhost:27017
RIDE_MONGODB_DATABASE=ridelink_rides
FARE_MONGODB_URI=mongodb://localhost:27017
FARE_MONGODB_DATABASE=ridelink_payments

# ---- Ports (the start scripts and Postman environment assume these) ----
ACCOUNT_SERVICE_PORT=8081
DRIVER_SERVICE_PORT=8082
RIDE_SERVICE_PORT=8083
FARE_SERVICE_PORT=8084

# ---- Where each service finds the services it calls ----
ACCOUNT_SERVICE_URL=http://localhost:8081
DRIVER_SERVICE_URL=http://localhost:8082
FARE_SERVICE_URL=http://localhost:8084

# ---- Matching rule: drivers must have reported a location within this many minutes ----
DRIVER_LOCATION_MAX_AGE_MINUTES=30
